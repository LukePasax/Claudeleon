{
  "name": "claudeleon",
  "productName": "Claudeleon",
  "version": "1.2.1",
  "description": "Claude Code in una finestra a temi",
  "repository": "github:LukePasax/Claudeleon",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node node_modules/electron/install.js",
    "dist": "node scripts/dist.js",
    "pack": "electron-builder --dir",
    "test": "node --test --test-timeout=30000 \"test/unit/*.test.js\"",
    "test:ui": "node --test --test-timeout=60000 \"test/ui/*.test.js\"",
    "test:all": "npm test && npm run test:ui"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "author": "Claudeleon",
  "build": {
    "appId": "ClaudeSkins.App",
    "productName": "Claudeleon",
    "copyright": "Claudeleon",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*{,/**}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "src/plugin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claudeleon",
      "uninstallDisplayName": "Claudeleon",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Claudeleon-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LukePasax",
        "repo": "Claudeleon",
        "releaseType": "release"
      }
    ]
  }
}
